    <Text style={{ fontSize: 16, color: '#C7D8F5' }}>02 · Architecture</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 148, left: 60, width: '1160px', flexDirection: 'column', gap: 12 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'stretch', height: '76px' }}>
      <Box style={{ width: '150px', background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}>
