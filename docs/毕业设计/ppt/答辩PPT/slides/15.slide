<Slide style={{ width: '1280px', height: '720px', background: '#FFFFFF', padding: 0, fontFamily: 'Microsoft YaHei' }}>
  <Box style={{ position: 'absolute', top: 60, left: 60, width: '1160px', height: '64px', background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 24px' }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>系统演示流程</Text>
    <Text style={{ fontSize: 16, color: '#C7D8F5' }}>04 · Demo</Text>
  </Box>

  <Box style={{ position: 'absolute', top: 148, left: 60, width: '1160px', flexDirection: 'column', gap: 16 }}>
    <Box style={{ flexDirection: 'row', gap: 12 }}>
      <Box style={{ width: '222px', padding: '14px', background: '#F7F9FC', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>① 选岗位</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>首页三栏工作台，可粘贴 JD 定制题目</Text>
      </Box>
      <Box style={{ width: '222px', padding: '14px', background: '#F7F9FC', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>② 设备检测</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>列出麦克风与摄像头，可选设备并记住</Text>
      </Box>
      <Box style={{ width: '222px', padding: '14px', background: '#F7F9FC', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>③ 开口作答</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>面试官提问，学生直接说，无需打字</Text>
      </Box>
      <Box style={{ width: '222px', padding: '14px', background: '#F7F9FC', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>④ 自动提交</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>停顿或结束词命中即提交，可空格打断</Text>
      </Box>
      <Box style={{ width: '222px', padding: '14px', background: '#E8EFF8', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1E4FA8' }}>⑤ 出报告</Text>
        <Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.5 }}>逐题复核 + 陪练计划 + 全程回放</Text>
      </Box>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 20 }}>
      <Box style={{ width: '566px', padding: '16px 18px', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E4FA8' }}>演示中值得重点展示的三处</Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>
          · <span style={{ fontWeight: 'bold' }}>Agent 工作台</span>：实时看到面试官在想什么、调了哪个工具、工具返回了什么
        </Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>
          · <span style={{ fontWeight: 'bold' }}>答偏时的自主纠正</span>：学生答非所问，Agent 会礼貌拉回并重新提问
        </Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>
          · <span style={{ fontWeight: 'bold' }}>报告页的双 Agent 产出</span>：评估官逐题「该怎么答」+ 陪练官一周计划
        </Text>
      </Box>
      <Box style={{ width: '566px', padding: '16px 18px', border: '1px solid #D6DCE5', flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 21, fontWeight: 'bold', color: '#1E4FA8' }}>演示环境准备</Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>· Windows 双击「启动面试.bat」，macOS / Linux 执行 start.sh</Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>· 首次启动自动安装识别运行时与模型（约 192 MB），支持镜像兜底与跳过</Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>· 全新目录实测：模型已缓存时约 9 秒完成启动</Text>
        <Text style={{ fontSize: 16, color: '#1A2230', lineHeight: 1.55 }}>· 未配置大模型时给出明确提示，可切换离线演示模式</Text>
      </Box>
    </Box>

    <Box style={{ padding: '14px 18px', background: '#E8EFF8' }}>
      <Text style={{ fontSize: 17, color: '#1A2230', lineHeight: 1.5 }}>
        <span style={{ fontWeight: 'bold', color: '#D9534F' }}>演示建议：</span>
        让面试官先答偏一次、再说一次「不会」，可以完整看到 Agent 的「纠正」与「降难度换题」两种自主决策。
      </Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', top: 670, left: 60, width: '1160px', flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>面镜 MockMirror · AI 模拟面试与能力提升软件</Text>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>15 / 20</Text>
  </Box>
</Slide>
