{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MockMirror 个人题库导入 v1",
  "type": "object",
  "required": ["schemaVersion", "position", "questions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "position": {"enum": ["java-backend", "python-algo", "web-frontend"]},
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["id", "type", "stage", "text", "keywords", "points", "hint", "reference"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-zA-Z0-9_-]+$"},
          "type": {"enum": ["tech", "project", "scenario", "behavior"]},
          "stage": {"enum": ["warm", "core", "deep"]},
          "text": {"type": "string", "minLength": 5, "maxLength": 600},
          "keywords": {"$ref": "#/$defs/list"},
          "points": {"$ref": "#/$defs/list"},
          "hint": {"type": "string", "minLength": 5, "maxLength": 1200},
          "reference": {"type": "string", "minLength": 30, "maxLength": 6000},
          "sources": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 1000, "pattern": "^https?://", "format": "uri"}}
        }
      }
    }
  },
  "$defs": {"list": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 300}}}
}
